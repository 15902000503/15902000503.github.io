VITE_BASE=/
# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# Facebook(Meta) 社媒登录（留空 = 演示模式，点击 Facebook 图标会提示未配置）
# Meta 开发者后台: https://developers.facebook.com/ -> 我的应用 -> 添加产品 Facebook Login
# App ID 在 设置-基本 页面；同时需配置 站点URL 和 有效的 OAuth 重定向 URI
VITE_FACEBOOK_APP_ID=1617757982830586

# Graph API 版本（可按 Meta 最新版本调整）
VITE_FACEBOOK_API_VERSION=v23.0

# Google 社媒登录（留空 = 演示模式，点击 Google 图标会提示未配置）
# Google Cloud Console -> API 和服务 -> OAuth 客户端 ID（Web 应用）
# 需在授权留定重定向 URI 中加入本站地址（如 http://localhost:5173）
VITE_GOOGLE_CLIENT_ID=790576136774-tseg5fbedr9lroplssjm76m7rpq14335.apps.googleusercontent.com

# GitHub 社媒登录（官方仅支持授权码流，无前端弹窗 SDK，换 token 必须服务端完成）
# 1) GitHub -> Settings -> Developer settings -> OAuth Apps -> New OAuth App
#    Callback URL 填站点根地址（如 http://localhost:5173/，不能带 # 片段）
# 2) 下面填 Client ID；Client Secret 只放后端，绝不能写进前端环境变量
# 3) VITE_GITHUB_EXCHANGE_URL 指向后端代理端点（参考实现 scripts/github-token-exchange.example.mjs）
# 两项都配置后才会真实跳转，否则点击提示未配置
VITE_GITHUB_CLIENT_ID=
VITE_GITHUB_EXCHANGE_URL=
